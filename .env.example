# Server-only. Never rename this to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# Best-effort limits per running server instance (not distributed limits).
AI_REQUESTS_PER_HOUR=30
AI_REQUESTS_PER_DAY=120
# Public frontend configuration for GitHub Pages (not a secret).
VITE_API_BASE_URL=
VITE_BASE_PATH=
# Allowed browser origin for Pages-to-Vercel API requests.
ALLOWED_ORIGINS=https://suhaskotyan.github.io
